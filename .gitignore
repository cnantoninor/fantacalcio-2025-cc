*.joblib

# Large data directories
datasets/
raw_data/
processed_data/

# FANTABUSTE data layout: raw/processed are gitignored (real data, per-user),
# fixtures/ is versioned on purpose (synthetic, is_synthetic=True, needed by
# every module's tests independent of real data availability).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# FANTABUSTE: the real league config carries this season's actual settings;
# keep only the annotated example in version control.
config/league.yaml

# Re-include fixtures despite the *.csv/*.xlsx/*.json blanket rules above —
# they are synthetic, versioned test data (is_synthetic=True), not scraped output.
!data/fixtures/
!data/fixtures/**
